# ── Server ──────────────────────────────────────
PORT=3000
APP_BASE_URL=http://localhost:3000

# ── SMTP (for parent approval emails + escalation alerts) ──
# Leave blank to disable email features.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Email address that receives escalation alerts for overdue complaints
ESCALATION_EMAIL=warden@yourhostel.com

# ── Twilio (for real parent voice calls on gate pass) ──
# Leave blank to use the in-browser simulated IVR instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
